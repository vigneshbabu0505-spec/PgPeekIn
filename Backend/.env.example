# Copy this file to `.env` (or set these as real environment variables /
# IntelliJ run-config values / system env vars) and fill in real values.
# NEVER commit the real .env file.

# PostgreSQL / Supabase database connection
DB_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Supabase storage
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_BUCKET=your_bucket_name

# JWT signing secret
JWT_SECRET=your_jwt_secret
